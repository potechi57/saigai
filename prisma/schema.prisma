// 道路防災カルテ Web GIS MVP — データモデル
//
// 設計の背景・レビュー時の指摘事項は ../../12_DATA_MODEL_WEBGIS_MVP.md を参照。
// 実際の防災カルテ様式（karte_sheet_jgca201307/01防災カルテ様式_落石・崩壊.xls、
// 全国地質調査業協会連合会 平成25年7月）の様式Ａ〜Ｄ・現状記録写真の構造に基づく。

generator client {
  provider        = "prisma-client-js"
  // relationJoins: 既定では、1対多・多対多のリレーションを含むinclude/selectは
  // リレーション毎に別のSQL文（IN句によるバッチ取得）に分解して実行される
  // （相手テーブルの行ごとにクエリが飛ぶ古典的なN+1ではないが、リレーションの数だけ
  // DBへの往復＝ネットワークラウンドトリップが発生する）。性能監査で実測した結果、
  // カルテ詳細ページの1回のfindUnique呼び出しが実際には8本のSQL文・約1.4秒に
  // 分解されていることを確認した。relationLoadStrategy: "join"（下記の各クエリ
  // 呼び出し側で指定）を使うとLATERAL JOINで1本のSQLにまとめられ、往復回数を
  // 大幅に減らせる。
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  // アプリの通常のクエリ実行にはNeonのプール接続（PgBouncer経由。ホスト名に
  // "-pooler"が付く方）を使う。
  url       = env("DATABASE_URL")
  // マイグレーション（`prisma migrate deploy`。package.jsonのbuildスクリプト
  // 参照）は、Neonのプール接続（PgBouncerのトランザクションプーリングモード）
  // だとセッション状態を維持できず、アドバイザリロック（SELECT
  // pg_advisory_lock(...)。同時に複数のマイグレーションが走らないようPrisma
  // が内部的に使う）の取得がタイムアウトすることがある（実際にVercelの本番
  // ビルドで「Error: P1002 ... Timed out trying to acquire a postgres
  // advisory lock」というエラーで発生済み）。directUrlに、プールを経由しない
  // 直接接続（ホスト名に"-pooler"が付かない方。Neonダッシュボードで確認できる）
  // を指定することで、migrate deploy実行時だけそちらを使うようにする
  // （通常のクエリ実行は引き続きurl＝プール接続を使う。Prisma公式ドキュメント
  // https://pris.ly/d/migrate-advisory-locking 参照）。
  directUrl = env("DIRECT_DATABASE_URL")
}

// ── enum（防災カルテ様式の"List"シートに存在する正式なコード表を採用） ──────────

// 点検対象項目（カルテ種別）。防災カルテ様式（全国地質調査業協会連合会版）の
// "List"シートには全10種のコード表があるが、島根県では防災カルテ点検を
// 「落石・斜面」（落石・崩壊）でのみ運用しているとのことのため、岩盤崩壊・
// 地すべり・雪崩・土石流の4種は本アプリでは扱わないことにした（会話ログ参照）。
// 様式・DBの列挙値としては原本の全10種のうち6種が残っているが、KarteRockfallDetail
// で詳細を持つのは引き続き落石・崩壊のみ。他種別は Karte 本体の登録は可能だが、
// 種別固有の詳細テーブル（KarteBridgeScourDetail 等）は未実装。
enum KarteType {
  ROCKFALL_COLLAPSE // 落石・崩壊
  EMBANKMENT // 盛土
  RETAINING_WALL // 擁壁
  BRIDGE_FOUNDATION_SCOUR // 橋梁基礎の洗掘
  SNOWDRIFT // 地吹雪
  OTHER // その他
}

enum ProjectCategory {
  GENERAL // 一般
  TOLL // 有料
}

// 道路種別（Listシートの主要なもののみ採用。将来項目が増えた場合はマスタテーブル化を検討）
enum RoadType {
  EXPRESSWAY // 高速自動車国道
  NATIONAL_DESIGNATED // 一般国道（指定区間）
  NATIONAL_UNDESIGNATED // 一般国道（指定区間外）
  MAJOR_PREFECTURAL // 主要地方道
  PREFECTURAL // 一般都道府県道
  MUNICIPAL_1 // 市町村道（1級）
  MUNICIPAL_2 // 市町村道（2級）
  MUNICIPAL_OTHER // 市町村道（その他）
  TOLL_ROAD // 一般有料道路
  URBAN_EXPRESSWAY // 都市高速道路
}

enum RoadStatus {
  CURRENT // 現道
  OLD // 旧道
  NEW // 新道
  NEWEST // 新新道
}

enum GeodeticSystem {
  WORLD // 世界測地系
  JAPAN // 日本測地系
}

enum Weather {
  SUNNY // 晴
  CLOUDY // 曇
  RAIN // 雨
  SNOW // 雪
}

// 対応区分。指示書が例示した5段階（異常なし〜要対策）ではなく、
// 実データ（Listシート「点検結果1」）の正式な3値に、初期状態（未評価）を加えた4値。
// Karte（カルテの現在の対応方針）と InspectionEvent.specialistJudgement
// （その点検時点での専門技術者の判定）の両方で共有する。
// 様式Ａの「評価」欄と様式Ｃの「点検後の対応（専門技術者の判定）」が同じ区分を指している
// らしいことは実データの構造から推測できるが、記入済みの実例では未確認のため、
// この対応関係（現在値のキャッシュ+履歴）は要検証（推測の範囲）。
enum ResponseCategory {
  UNEVALUATED // 未評価（初期値。様式上は空欄に相当）
  COUNTERMEASURE_NEEDED // 対策工が必要
  HANDLED_BY_KARTE // カルテ対応
  NO_COUNTERMEASURE_NEEDED // 対策不要
  COUNTERMEASURE_COMPLETED // 対策完了
}

enum InspectionPeriodType {
  REGULAR // 定期
  IRREGULAR // 不定期
}

// 写真の由来様式。旧Excelからの移行時のトレーサビリティ用（新規登録では通常 OTHER でよい）
enum PhotoSourceForm {
  FORM_A // 様式Ａ（点検地点位置図）
  FORM_B // 様式Ｂ（詳細スケッチ・写真張付欄）
  FORM_D // 様式Ｄ（平面図・断面図・現況写真）
  GENERAL_RECORD // 現状記録写真（様式に収まらなかった写真）
  OTHER
}

// ── カルテ本体 ──────────────────────────────────────────────

model Karte {
  id String @id @default(cuid())

  // 施設管理番号。様式上は1マスに半角1文字ずつ入力する仕様だが、
  // アプリ内部では結合済みの文字列として1カラムで保持する。
  facilityNo String    @unique
  karteType  KarteType

  manageOrgName String? // 管理機関名
  manageOrgCode String? // 管理機関コード
  ledgerNo      String? // 台帳番号

  routeName String // 路線名
  routeNo   String? // 路線番号（指示書3.1に記載あり、様式上は路線名に含まれるため任意）

  // 距離標。様式は「km(4桁)」「m(2桁)」の別セル入力＋マイナス距離標対応だが、
  // アプリ内部では小数kmに正規化して1カラムで保持する（符号はそのままマイナス値で表現）。
  distanceMarkerFromKm Decimal? @db.Decimal(7, 3)
  distanceMarkerToKm   Decimal? @db.Decimal(7, 3)
  sideOfRoad           String? // 上下線の別（上/下/他 等、選択肢が少なくないため自由入力）

  extensionLengthM Decimal? @db.Decimal(8, 1) // 延長(m)

  projectCategory ProjectCategory?
  roadType        RoadType?
  roadStatus      RoadStatus?

  // 所在地
  locationDistrict String? // 郡・支庁 等
  locationTown     String? // 市区町村
  landmark         String? // 位置目印

  latitude       Decimal?        @db.Decimal(9, 6) // 10進度に変換して保持（様式は度分秒入力）
  longitude      Decimal?        @db.Decimal(9, 6)
  geodeticSystem GeodeticSystem?

  preTrafficRestriction Boolean? // 事前通行規制区間指定 有/無
  continuousRainfallMm  Int? // 規制基準等：連続雨量(mm)
  hourlyRainfallMm      Int? // 規制基準等：時間雨量(mm)

  trafficVolumeWeekday Int? // 交通量：平日(台/12h)
  trafficVolumeHoliday Int? // 交通量：休日(台/12h)

  // 交通量の出典となる道路交通センサスの調査年度・観測地点番号。実データで
  // 「H27」（元号＋年）「Q11990」（観測地点番号）という書式を確認済み。年度・番号とも
  // 単純な数値ではない（元号付き・英字混じり）ため文字列のまま保持する。
  trafficCensusYear      String? // センサス調査年度（例:「H27」）
  trafficCensusPointCode String? // センサス観測地点番号（例:「Q11990」）

  didArea               Boolean? // DID区間 該当/非該当
  busRoute              Boolean? // バス路線 該当/非該当
  detour                Boolean? // 迂回路 有/無
  emergencyRoadCategory String? // 緊急輸送道路区分（指定有/指定無 等）

  specialistInspectionRequired Boolean? // 専門技術者による点検 有/無

  keyDeformationSummary    String? @db.Text // 着目すべき変状（様式Aの共通コメント）
  inspectionContentSummary String? @db.Text // 点検内容の要点
  specialistComment        String? @db.Text // 専門技術者のコメント

  responseCategory    ResponseCategory @default(UNEVALUATED) // 対応するものに○印（①〜④）
  responseEvaluatedAt DateTime? // 評価年月日

  inspectionPeriodType   InspectionPeriodType?
  inspectionIntervalNote String? // 例: "1年に1回"（Listの値をそのまま格納）

  assumedDisasterForm  String? @db.Text // 想定される災害形態
  responseWhenDeformed String? @db.Text // 変状が出たときの対応

  createdOnSiteDate    DateTime? // 様式作成年月日
  createdOnSiteWeather Weather?

  inspectorName    String? // 点検者名（作成時点）
  inspectorCompany String?
  inspectorTel     String?

  specialistName    String? // 専門技術者名（作成時点）
  specialistCompany String?
  specialistTel     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rockfallDetail KarteRockfallDetail?
  targets        InspectionTarget[]
  events         InspectionEvent[]
  disasterEvents DisasterEvent[]
  photos         Photo[]
  attachments    AttachmentDocument[]
  favorite       Favorite?

  @@index([karteType])
  @@index([routeName])
}

// 落石・崩壊カルテ固有の属性（様式Ａ下部「主な災害形態」チェック欄）。
// 他の9種別（岩盤崩壊・地すべり・雪崩・土石流・盛土・擁壁・橋梁基礎の洗掘・地吹雪・その他）を
// 追加する際は、Karte 本体を変更せず KarteXxxDetail を新設して Karte と1:1で結ぶ。
// 例: 橋梁基礎の洗掘は橋梁名・橋長・河川名（河川管理者）が様式Ａに追加される。
model KarteRockfallDetail {
  id      String @id @default(cuid())
  karteId String @unique
  karte   Karte  @relation(fields: [karteId], references: [id], onDelete: Cascade)

  mainFormRockfall Boolean @default(false) // 主な災害形態：落石
  mainFormCollapse Boolean @default(false) // 主な災害形態：崩壊
}

// ── 点検対象（変状No.相当） ──────────────────────────────────

model InspectionTarget {
  id      String @id @default(cuid())
  karteId String
  karte   Karte  @relation(fields: [karteId], references: [id], onDelete: Cascade)

  // カルテ内での通し番号。表示用コードは "{facilityNo}-T{sequenceNo}" のように
  // アプリ層で組み立てる（実データの「変状No.」は数値のみのため）。
  sequenceNo Int

  name        String // 対象名称（例:「起点側法面」「P-3付近の浮石」等、自由記述）
  description String? @db.Text

  // 以下は様式Ｂ（着目すべき変状の詳細記録）相当の項目。
  // 様式Ｂの「<詳細スケッチ欄>」「<写真張付欄>」は、固定2枠ではなく
  // Photo（sourceForm=FORM_B）の複数枚アップロードとして自由度高く扱う
  // （紙の様式より柔軟にできる点はデジタル化のメリットとして活かす）。
  keyPoints            String?   @db.Text // 着目すべき点
  checkItems           String?   @db.Text // チェック項目
  createdOnSiteDate    DateTime? // 様式Ｂの作成年月日（様式Ａ全体の作成日とは別に、変状ごとに記録される）
  createdOnSiteWeather Weather?

  isActive     Boolean @default(true) // 解消済み等になった場合はfalseにする（論理的な終了、削除はしない）
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results        InspectionResult[]
  disasterEvents DisasterEvent[]
  photos         Photo[]

  @@unique([karteId, sequenceNo])
}

// ── 点検イベント（1回の訪問。点検対象をまたいで共通の情報） ──────────────

model InspectionEvent {
  id      String @id @default(cuid())
  karteId String
  karte   Karte  @relation(fields: [karteId], references: [id], onDelete: Cascade)

  inspectionDate DateTime
  inspectorName  String?
  weather        Weather?

  specialTopics String? @db.Text // 点検時の特記事項（点検時の対応）

  specialistInspectionDate DateTime?
  specialistName           String?
  specialistJudgement      ResponseCategory? // 点検後の対応（専門技術者の判定）。Karte.responseCategoryと同じ区分（推測、要検証）

  nextInspectionDueYear Int? // 次回点検実施時期（年度）

  createdAt DateTime @default(now())

  results InspectionResult[]
  photos  Photo[]

  // Excel取込の再実行（同じファイルを再アップロード等）で点検イベントが
  // 重複作成されないよう、カルテ×点検日で一意にする（upsertのキーとして使う）。
  @@unique([karteId, inspectionDate])
}

// ── 点検結果（点検イベント×点検対象の交差） ────────────────────────

model InspectionResult {
  id String @id @default(cuid())

  eventId  String
  event    InspectionEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  targetId String
  target   InspectionTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  diffFromPrevious Boolean? // 前回との差異 有/無
  disasterHistory  Boolean? // 被災履歴 有/無
  repairHistory    Boolean? // 補修履歴 有/無
  comment          String?  @db.Text

  createdAt DateTime @default(now())

  @@unique([eventId, targetId])
}

// ── 災害履歴（様式Ｄ相当。被災・対策工の実績があった場合のみ作成） ──────────

model DisasterEvent {
  id      String @id @default(cuid())
  karteId String
  karte   Karte  @relation(fields: [karteId], references: [id], onDelete: Cascade)

  targetId String?
  target   InspectionTarget? @relation(fields: [targetId], references: [id], onDelete: SetNull)

  disasterType KarteType? // 災害種別（Listの「被災種別」もKarteTypeとほぼ同じ語彙のため共有）
  occurredDate DateTime?

  // 規模
  scaleWidthM  Decimal? @db.Decimal(6, 2)
  scaleLengthM Decimal? @db.Decimal(6, 2)
  scaleDepthM  Decimal? @db.Decimal(6, 2)
  scaleComment String?  @db.Text

  // 誘因（該当するものだけ入力する想定。単一カテゴリ選択ではなく実測値の記録に近いため個別カラム）
  rainContinuousMm       Int?
  rainMaxHourlyMm        Int?
  seismicIntensity       String? // 例:「震度5弱」
  seismicAccelerationGal Int?
  snowTemperatureC       Decimal? @db.Decimal(4, 1)
  snowDepthM             Decimal? @db.Decimal(5, 2)
  causeComment           String?  @db.Text

  // 被害
  damageDeaths                   Int?
  damageInjured                  Int?
  propertyDamageComment          String?  @db.Text
  propertyDamageAmountMillionYen Decimal? @db.Decimal(10, 1)

  // 通行止め実績・対策工
  closureFullHours    Decimal? @db.Decimal(6, 1)
  closurePartialHours Decimal? @db.Decimal(6, 1)
  shoulderRestriction Boolean?

  countermeasureFiscalYear     Int?
  countermeasureType           String?  @db.Text // 提案対策工マスタ（約150項目）は未テーブル化のため自由入力
  countermeasureCostMillionYen Decimal? @db.Decimal(10, 1)

  comment String? @db.Text

  createdOnSiteDate    DateTime?
  createdOnSiteWeather Weather?

  createdAt DateTime @default(now())

  photos Photo[]

  @@index([karteId, occurredDate])
}

// ── 写真 ────────────────────────────────────────────────

model Photo {
  id String @id @default(cuid())

  karteId String
  karte   Karte  @relation(fields: [karteId], references: [id], onDelete: Cascade)

  targetId String?
  target   InspectionTarget? @relation(fields: [targetId], references: [id], onDelete: SetNull)

  eventId String?
  event   InspectionEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  disasterEventId String?
  disasterEvent   DisasterEvent? @relation(fields: [disasterEventId], references: [id], onDelete: SetNull)

  url        String // Vercel Blob等のオブジェクトストレージURLを想定
  sourceForm PhotoSourceForm @default(OTHER)

  takenAt      DateTime?
  takenBy      String?
  takenLat     Decimal?  @db.Decimal(9, 6)
  takenLng     Decimal?  @db.Decimal(9, 6)
  caption      String?
  displayOrder Int       @default(0)

  createdAt DateTime @default(now())

  @@index([karteId])
  @@index([targetId])
}

// ── アプリ設定（ホーム位置等） ────────────────────────────────
// 現時点ではログイン機能が無いMVPのため、ユーザーごとではなく事務所で1つだけ共有する
// シングルトン行（id="singleton"固定）として保持する。県土整備事務所など、点検の
// 起点となる拠点の緯度経度を保存し、各カルテ地点までの距離表示に使う
// （lib/geo.ts参照）。将来ログイン機能が入った場合は、ユーザーごとのテーブルに分割する。
model AppSettings {
  id String @id @default("singleton")

  homeLatitude  Decimal? @db.Decimal(9, 6)
  homeLongitude Decimal? @db.Decimal(9, 6)
  homeLabel     String? // 例:「○○県土整備事務所」（任意のメモ、地図上のホームピンの表示にも使う）

  updatedAt DateTime @updatedAt
}

// ── お気に入り ──────────────────────────────────────────────
// ログイン機能が無いMVPのため、ホーム位置（AppSettings）同様、事務所全体で1つを
// 共有するお気に入りリストとして実装する（ユーザーごとの分離は将来ログイン機能が
// 入ってから対応する）。
// 対象1件につきお気に入りは高々1件（各対象IDをunique）とし、
// グルーピングは別テーブルFavoriteGroupへの多対多とすることで、
// 「1件のお気に入りを複数のグループ（例:『今年の点検場所』『要注意箇所』）に
// 同時に所属させる」を許容しつつ、グループ無し（未分類）のお気に入りも表現できる。
// 中間テーブルはPrismaの暗黙的m:n（生成されるテーブル名・カラム名が推測しづらく、
// 手書きマイグレーションと相性が悪い）ではなく、明示的なFavoriteGroupItemとして持つ
// （InspectionResult等、このプロジェクトの他のm:nも同じ方針で明示テーブル化している）。
//
// 【karteId専属からの一般化】当初は防災カルテ（Karte）専用だったが、
// 「お気に入り追加はカルテのみでは意味がありません。点検調書の項目すべてに
// 適用できるようにしてください」との指摘を受け、他の点検調書種別（まずは
// 門型標識＝GateSignInspection）にも対応できるよう一般化した。Prismaは
// 真の多態関連（1つの外部キー列が複数モデルのいずれかを指す）を型安全には
// サポートしないため、対象種別ごとに「nullableな専用外部キー列」を1つずつ
// 追加する方式にした（entityType文字列＋entityId文字列だけを持つ汎用テーブルに
// する案も検討したが、それだと結局アプリケーション側でentityTypeによる分岐が
// 必要になる点は変わらず、かつ外部キー制約による整合性保証・カスケード削除を
// 失うため不採用）。アプリケーション側（lib/actions/favorite-actions.ts）で
// 「作成時は必ずどちらか一方だけを設定する」という不変条件を守る。
// 橋梁点検調書（BridgeInspection）等、まだ地図・検索に組み込まれていない
// 点検調書種別は、実際にその画面が使えるようになったタイミングで、同じ要領で
// 専用の外部キー列を追加すればよい。
model Favorite {
  id      String  @id @default(cuid())
  karteId String? @unique
  karte   Karte?  @relation(fields: [karteId], references: [id], onDelete: Cascade)

  gateSignInspectionId String?             @unique
  gateSignInspection   GateSignInspection? @relation(fields: [gateSignInspectionId], references: [id], onDelete: Cascade)

  bridgeInspectionId String?           @unique
  bridgeInspection   BridgeInspection? @relation(fields: [bridgeInspectionId], references: [id], onDelete: Cascade)

  bridgeLedgerId String?      @unique
  bridgeLedger   BridgeLedger? @relation(fields: [bridgeLedgerId], references: [id], onDelete: Cascade)

  // 法令台帳・施設台帳（画像。トンネル台帳等）共通（会話ログ「法令台帳・
  // 施設台帳：お気に入り対応」参照）。
  facilityLedgerId String?         @unique
  facilityLedger   FacilityLedger? @relation(fields: [facilityLedgerId], references: [id], onDelete: Cascade)

  slopeStructureInspectionId String?                   @unique
  slopeStructureInspection   SlopeStructureInspection? @relation(fields: [slopeStructureInspectionId], references: [id], onDelete: Cascade)

  note String? // お気に入りに追加した際の任意メモ

  createdAt DateTime @default(now())

  groupItems FavoriteGroupItem[]
}

model FavoriteGroup {
  id   String @id @default(cuid())
  name String @unique // 例:「今年の点検場所」

  createdAt DateTime @default(now())

  items FavoriteGroupItem[]
}

model FavoriteGroupItem {
  id String @id @default(cuid())

  favoriteId String
  favorite   Favorite @relation(fields: [favoriteId], references: [id], onDelete: Cascade)

  groupId String
  group   FavoriteGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([favoriteId, groupId])
}

// ── 編集履歴（簡易監査ログ） ────────────────────────────────────
// ヘッダーの「編集履歴」から直近の編集操作を確認できるようにするための簡易ログ。
// ログイン機能が無いMVPのため「誰が」は記録できず、「いつ・何を・どう変更したか」の
// サマリ文字列のみを保持する（詳細な差分は持たない。lib/audit.ts参照）。
enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id String @id @default(cuid())

  action     AuditAction
  entityType String // 例:「カルテ」「点検対象」「点検記録」「Excel取込」
  summary    String // 例:「サンプル県道１号線（SAMPLE-0001）を更新」

  // カルテ削除等で参照先が無くなっても記録自体は残したいため、対象レコードへの
  // 外部キーは張らない。カルテ（点検調書＞災害）はfacilityNoの文字列だけを保持する
  // 従来からの仕組み、それ以外（施設台帳・台帳（画像）等）はlinkHrefに詳細ページの
  // パスをそのまま文字列で保持する、という2way構成になっている（linkHrefは会話ログ
  // 「それ以外の登録や編集の内容を表示するようにしてほしい」を受けて追加。
  // カルテ以外の詳細ページは対象ごとにURLの形が違う＝facilityNoのような単一の
  // 識別子では表現できないため、パスそのものを持たせる方が単純）。どちらも参照先が
  // 消えていればリンクなしの単なるテキスト表示にフォールバックする
  // （履歴画面側。app/karte/history/page.tsx参照）。
  karteFacilityNo String?
  linkHref        String?

  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ── カルテ資料（元カルテPDF等） ───────────────────────────────

model AttachmentDocument {
  id      String @id @default(cuid())
  karteId String
  karte   Karte  @relation(fields: [karteId], references: [id], onDelete: Cascade)

  title      String
  url        String
  fileType   String? // "pdf" 等
  uploadedAt DateTime @default(now())
}

// ── Excel取込履歴 ───────────────────────────────────────────
// 「どのExcelファイルをいつ取り込んだか」を確認できるようにするための履歴。
// 取込処理の開始時にIN_PROGRESSで作成し、完了時にSUCCESS/FAILUREへ更新する
// （lib/actions/import-actions.tsのcreateImportHistory/finishImportHistory*参照）。
// ブラウザのlocalStorageではなくDBに保存することで、複数端末・複数職員での
// 共有履歴として機能する。

enum ImportHistoryStatus {
  IN_PROGRESS
  SUCCESS
  FAILURE
}

model ImportHistory {
  id     String              @id @default(cuid())
  status ImportHistoryStatus @default(IN_PROGRESS)

  fileName String // 取り込んだExcelファイル名

  // AuditLogと同じ方針で、カルテ削除等で参照先が無くなっても履歴自体は残したいため
  // Karteへの外部キーは張らずファシリティ番号の文字列だけを保持する。取込処理の
  // 早い段階（ファイルの解析前）ではまだ判明していないためnull、様式Ａの解析後に埋める。
  facilityNo String?

  targetCount Int? // 取り込んだ点検対象（様式Ｂ）数
  eventCount  Int? // 取り込んだ点検記録（様式Ｃ）数

  errorMessage String? // 失敗時のエラー内容（取込ボタンを押した画面にそのまま表示されたもの）

  // 将来、ログイン機能を追加した際に「誰が取り込んだか」を埋める想定の予約フィールド
  // （現状はログイン機能が無いため常にnull）。
  importedBy String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([startedAt])
}

// ── その他の台帳（トンネル台帳など） ─────────────────────────────
// 道路防災カルテ（Karte）とは別の枠組み。既存の紙台帳がスキャン画像でしか
// 残っておらず、Excelのような構造化データが無い（＝項目ごとに取り込む
// karte-import.tsのような抽出ロジックを組む対象にならない）台帳を、
// 「画像1枚＋最低限の基本情報」という単純な形で登録し、地図上のピンから
// 参照できるようにするためのもの。まずはトンネル台帳のみに対応する
// （将来、橋梁・法面等の台帳にも同じ仕組みを流用する想定でcategoryを
// enumにしている）。
// 「台帳（画像）」がどちらの最上位分類（検索・地図画面のタブと同じ）に属するかを
// 表す。以前はFacilityLedger＝法令台帳と誤って対応付けていたが、実際には
// 「トンネル台帳」は施設台帳（FACILITY）に属し、法令台帳（LEGAL）側は
// 「トンネル調書」等の別物であるとの指摘を受けて訂正した（会話ログ参照）。
// 画像による登録という方法自体は法令台帳・施設台帳のどちらでも必要になるため、
// FacilityLedgerモデル自体は共有し、このdocClassで区別する。
enum FacilityLedgerDocClass {
  LEGAL // 法令台帳
  FACILITY // 施設台帳
}

model FacilityLedger {
  id String @id @default(cuid())

  docClass FacilityLedgerDocClass

  // 分野・施設名称は、島根県公共土木施設台帳の分類（lib/facility-taxonomy.ts・
  // 検索画面の法令台帳タブと同じ分類）から選ぶ、自由記述の文字列。
  // FacilityListItem.facilityType/facilitySubTypeと同じ考え方（コード化された
  // enumにはせず、分類の追加・変更にスキーマ変更を要さないようにしている）。
  // 台帳名・路線名・所在地・緯度経度と合わせて、全て任意項目にしている
  // （画像さえあれば登録でき、詳細は後から編集画面で補える運用を想定。
  // 会話ログ「全てを入れなくてもよいように」参照）。
  facilityType    String?
  facilitySubType String?

  // 管理番号（施設一覧・FacilityListItem.managementNoに相当する概念）。画像台帳は
  // Excelのような構造化データの裏付けが無いまま登録されることが多く、管理番号が
  // 分かっていない・そもそも採番されていない施設も存在するため、任意項目にしている。
  // 表示時は管理番号があればそれを、無ければname（例:「魚瀬トンネル」）を使う
  // （lib/labels.tsのfacilityLedgerDisplayName参照。会話ログ「管理番号がなくても、
  // 施設名で表示できるように」参照）。
  managementNo String?

  name      String? // 台帳名（任意。例: 魚瀬トンネル）
  routeName String? // 路線名
  location  String? // 所在地（自由記述。例: 自 松江市秋鹿町 至 松江市魚瀬町）

  // 地図上のピン表示に使う座標。karte-import.ts同様、度分秒ではなく
  // 10進度に変換して保持する想定（登録画面から手入力する）。
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  note String? // 特記事項等の自由記述欄

  // 台帳の画像は1枚とは限らない（同じ施設に調書・図面等、複数枚をまとめて
  // 登録したり、後から追加したりする運用のため）。以前はFacilityLedger本体に
  // imageUrlを1つだけ持たせていたが、1施設内で複数画像をタブ切替表示し、
  // タブ名（label）を後から自由に変更できるようにするため、別テーブルに
  // 切り出した（会話ログ参照。/ledgers/[id]で「Excelシート風タブ」
  // （components/SheetTabs.tsx）を使って切り替える）。
  images   FacilityLedgerImage[]
  favorite Favorite? // GateSignInspection.favoriteと同じ考え方（Favoriteモデルのコメント参照）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([docClass])
  @@index([facilityType])
}

// FacilityLedger 1件に紐づく画像1枚（調書・図面等）。labelは表示用のタブ名で、
// 登録時は「画像1」のように自動採番するが、登録後に自由に変更できる
// （/ledgers/[id]。会話ログ「タブの名前付けは任意として、取り込ませたあとに
// 任意で修正できるように」参照）。sortOrderはタブの並び順（登録順）。
model FacilityLedgerImage {
  id String @id @default(cuid())

  ledgerId String
  ledger   FacilityLedger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  label     String // タブ名（自由記述。例: 調書、平面図、断面図）
  imageUrl  String // Vercel Blob
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ledgerId])
}

// ── 施設一覧（Access等から出力される施設管理台帳） ────────────────────
// 島根県の実データ「施設一覧(道路法面施設).xlsx」「施設一覧.xlsx」（道路標識）で
// 構造を確認済み。防災カルテ（Karte）とは全く別の形式・目的のデータで、1シートに
// 多数の施設が一覧で並ぶ「施設管理データベース」の出力そのもの。様式Ａ〜Ｄのような
// 詳細記録は無く、施設の基本情報（台帳）＋点検記録という、よりシンプルな構成。
//
// 管理番号で一意に識別され、台帳本体（施設諸元・直近点検のスナップショット）は
// 再取込のたびに同じ管理番号の行が上書き更新される（カルテのfacilityNoと同じ
// 考え方）。
model FacilityListItem {
  id String @id @default(cuid())

  managementNo    String  @unique // 管理番号（例: A01-AH-900051）
  oldManagementNo String? // 旧管理番号
  officeName      String? // 管轄事務所
  facilityField   String? // 施設分野（例: 道路）
  routeType       String? // 路線種別（原本ヘッダーは「道川湾地区種別」という表記だが、
  // 実データの値は「国道」「主要地方道」「一般県道」等の道路種別そのもの）
  routeName       String? // 路線名（原本ヘッダーは「道川湾地区名」。実データは「（国）４３１号」等）
  facilityType    String? // 施設種別
  facilitySubType String? // 施設細別
  facilityName    String? // 施設名称
  location        String? // 所在地

  // 原本は「緯度経度」列に"35.488,133.083"のようなカンマ区切り文字列で
  // 入っているため、取込時に分解して保持する。
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  constructionYear String? // 建設年度（実データにExcel日付起因と思われる"1899"等の
  // 異常値が混在していたため、数値化・日付化せず文字列のまま保持する）
  remarks          String? // 備考

  regulationLedgerName      String? // 法令台帳・名称
  regulationLedgerUpdatedAt String? // 法令台帳・作成・更新
  facilityLedgerName        String? // 施設台帳・名称（将来、FacilityLedgerと紐付ける余地あり）
  facilityLedgerUpdatedAt   String? // 施設台帳・作成・更新

  // 以下は「直近の点検」を示す最新値のスナップショット（一覧表示・検索条件の
  // 選択肢に使う。Karte.responseCategoryと同じ、現在値を本体に持たせる考え方）。
  // 施設一覧Excelの再取込のたびに上書きされる。かつては都度の記録を別テーブル
  // （FacilityInspectionRecord）に履歴として積み上げていたが、運用上不要と
  // なったため削除した（会話ログ「点検記録は不要」参照。台帳側のこのスナップ
  // ショットのみ残す）。
  inspectionType String? // 点検種別（最新）
  soundnessGrade String? // 健全度（最新。例: "Ⅱ"）
  inspectionDate DateTime? // 点検実施日（最新）
  inspector      String? // 点検実施者（最新）
  mainFindings   String? // 主な所見（最新）
  repairDate     String? // 修繕年月日（最新）
  repairRemarks  String? // 修繕記録の備考（最新）

  gateSignInspections       GateSignInspection[]
  bridgeLedgers             BridgeLedger[]
  bridgeInspections         BridgeInspection[]
  slopeStructureInspections SlopeStructureInspection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([officeName])
  @@index([facilityType])
  // routeName・soundnessGradeはapp/karte/page.tsxの検索条件（等価一致）・
  // ドロップダウン選択肢集計（distinct）の両方で使われるが、インデックスが無かった
  // （性能監査で発覚）。現在の行数（数十件）では実行計画上の差は測定誤差レベルだが、
  // データ量が増えた際に備えて追加しておく。
  @@index([routeName])
  @@index([soundnessGrade])
}

// ── 点検調書（道路＞門型標識） ─────────────────────────────────────
// 点検調書タブ＞道路＞門型標識（会話ログ「別紙２　様式１様式２」のExcel参照）。
// 島根県の「道路土工構造物等定期点検要領」系の様式で、1施設1ファイルの
// 詳細な点検報告書（様式１＝基本情報・部材単位の総括、様式２＝損傷箇所ごとの
// 写真付き詳細カード）。施設台帳（FacilityListItem）の道路標識（門型）行と
// 管理番号で紐付く（会話ログ「施設台帳の道路標識に紐づけるデータになります」
// 参照）。ただしExcel内には管理番号が空欄のことが多く、ファイル名
// （例:「A01-AE-010474_01_松江島根線_松江市上乃木町_0.54_門型標識柱.xlsx」の
// 先頭）から取得する（lib/excel/gate-sign-inspection-import.ts参照）。
// facilityListItemIdは紐付けできた場合のみ設定し（見つからない場合はnullのまま
// 保存し、後から手動で紐付けることも今のところできない簡易な仕様）、
// カルテ削除等と同様に紐付け先が消えても記録自体は残す（onDelete: SetNull）。
model GateSignInspection {
  id String @id @default(cuid())

  facilityListItemId String?
  facilityListItem   FacilityListItem? @relation(fields: [facilityListItemId], references: [id], onDelete: SetNull)
  managementNo       String? // ファイル名から取得（Excel内は空欄のことが多い）

  facilityName String? // 施設名（例: 道路標識）
  facilityForm String? // 形式（例: 門型式）
  routeName    String?
  location     String?
  // Excel上の「ＩＤ番号」欄（様式（その１）行4のQ列）。実データでは空欄のことが
  // 多いが、項目自体は実在するため取り込んでおく（会話ログ「ID欄は確認する限り
  // 空白ですが、－をいれるなどして、とりあえず、実装しておいていください」参照）。
  idNumber     String?

  // IMS設定シート（緯度(度)(分)(秒)・経度(度)(分)(秒)）から10進度に変換して保持する
  // （karte-import.ts等と同じ方針）。
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  inspectionDate   DateTime? // 定期点検実施年月日
  inspectorCompany String? // 定期点検者（会社名）
  inspectorName    String? // 記録者名
  managerOrgName   String? // 管理者名

  hasAlternateRoute      String? // 代替路の有無（有/無）
  emergencyTransportRoad String? // 緊急輸送道路（一次/二次/三次/その他）
  roadCategory           String? // 自専道or一般道
  occupyingObjects       String? // 占用物件（名称）

  installedYear  Int? // 設置年（西暦）
  installedMonth Int? // 設置月
  roadWidthM     Decimal? @db.Decimal(6, 2) // 道路幅員(ｍ)
  structureType  String? // 構造形式

  overallJudgment String? // 門型標識等毎の健全性の診断（判定区分Ⅰ〜Ⅳ）
  overallFindings String? // 同上の所見

  // 様式（その１）の「部材単位の健全性の診断」総括表（支柱・横梁・標識板または
  // 道路情報板・基礎・その他の5行固定、各行に判定区分・変状の種類・備考・
  // 応急措置後の判定区分・応急措置内容・応急措置及び判定実施年月日の6項目）。
  // GateSignInspectionMember（様式２の詳細カード）と内容が重なる粗い情報だが、
  // 様式１タブは概要表示という位置づけのため、こちらも表示してほしいとの要望
  // （会話ログ「様式1は概要を表示するという観点で部材ごとの健全性の診断も
  // 表示してほしい」参照）を受けて追加した。行数・列構成が固定（Excelの様式上
  // 常に5部材×6項目）で、GateSignInspectionMemberのように検索・絞り込みの
  // 対象にする必要も無いため、別テーブル化はせずJSON列としてそのまま保持する
  // （BridgeLedgerSheetData.gridと同じ考え方）。要素の型は
  // lib/excel/gate-sign-inspection-import.tsのGateSignInspectionMemberOverviewRow参照。
  memberOverview Json?

  sourceFileName String? // 取込元Excelファイル名（参考情報。再取込時の重複判定にも使う）

  // 年度ごとの履歴保存（会話ログ「点検年度ごとに履歴として保存する」参照）。
  // 以前は同じ管理番号のファイルを再取込みすると既存レコードを削除して
  // 作り直しており、(1) お気に入り・共有済みURLが無効になる、(2) 前回点検の
  // 判定・写真が跡形もなく消え、経年比較ができない、という2つの問題があった
  // （会話ログ「点検調書の再取込みで、IDが変わり、過去のデータが消える」参照。
  // 実際にこのセッション中、橋梁の再取込みでIDが変わる場面があった）。
  //
  // そこで、削除せずに新しいレコードを作り、旧レコードのpreviousInspectionIdに
  // 新レコードのidをセットして連鎖させる方式にした（カルテのKarte＋KarteEvent
  // 「基本情報は上書き・点検記録は積み上げ」という既存の考え方を、門型標識・
  // 橋梁向けに単純化して適用したもの。新モデルを増やさず自己参照で済ませている）。
  // 「現在有効な最新レコード」はsupersededByInspection（逆参照）がnullのもの
  // （地図・検索一覧はこの条件で絞り込むだけでよい）。旧レコードのURLは
  // リダイレクトせずそのまま表示できるようにし（詳細画面に「新しい年度の記録が
  // あります」という案内を出す）、お気に入りだけは新レコードへ引き継ぐ
  // （lib/actions/gate-sign-inspection-actions.tsのsupersedeロジック参照）。
  previousInspectionId   String?             @unique
  previousInspection     GateSignInspection? @relation("GateSignInspectionHistory", fields: [previousInspectionId], references: [id], onDelete: SetNull)
  supersededByInspection GateSignInspection? @relation("GateSignInspectionHistory")

  members        GateSignInspectionMember[]
  overviewPhotos GateSignInspectionPhoto[]
  favorite       Favorite? // Karteのfavoriteフィールドと同じ考え方（Favoriteモデルのコメント参照）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([managementNo])
  @@index([facilityListItemId])
}

// 様式２の「損傷箇所ごとの写真付き詳細カード」を1枚＝1レコードとして保持する
// （様式１側の部材単位の総括表は、内容が重なりより粗いため別テーブル化はせず、
// GateSignInspection.memberOverviewにJSONとして保持する。会話ログ「読み込んで
// 表示できる仕様に」に対する実装上の判断）。
model GateSignInspectionMember {
  id           String             @id @default(cuid())
  inspectionId String
  inspection   GateSignInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  // 元Excelの「状況写真（損傷状況）」シート（様式（その２）／様式（その２）2／
  // 様式（その２）3…と、損傷箇所の数に応じて複製される）のうち、何枚目のシート
  // 由来かを1始まりで表す。詳細画面でExcelのタブ構成に合わせて表示するため
  // （会話ログ「状況写真のタブを３つ作ってください...タブが4つ5つあるものは、
  // それに合わせて複数作成できる仕様に」参照。karte詳細画面の「現状記録写真」タブ
  // （Photo.displayOrderで元シートごとにグループ化する仕組み）と同じ考え方）。
  pageNo Int @default(1)

  photoNo      Int? // 写真番号
  memberName   String? // 部材名（大分類。例: 支柱）
  memberDetail String? // 部材名詳細（例: 支柱本体）
  damageType   String? // 変状の種類
  judgment     String? // 健全性の診断（定期点検時。判定区分Ⅰ〜Ⅳ）

  postActionJudgment String? // 応急措置後の判定区分
  postActionContent  String? // 応急処置内容

  findings String? // 所見
  remarks  String? // 備考欄

  photoUrl String? // 損傷状況写真（Vercel Blob）

  sortOrder Int @default(0)

  @@index([inspectionId])
}

// 様式１の「全景写真」欄（起点側・終点側）等、個別損傷とは紐付かない全体写真。
model GateSignInspectionPhoto {
  id           String             @id @default(cuid())
  inspectionId String
  inspection   GateSignInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  url       String
  caption   String? // 例: 起点側、終点側
  sortOrder Int     @default(0)

  @@index([inspectionId])
}

// ── 橋梁台帳（島根県 橋梁点検・橋梁台帳システム(IMS)由来のExcel） ──────────
// 1ファイル＝1橋。Excelは5シート構成: 「橋梁調書」（橋名・路線名・所在地・
// 緯度経度・橋長・幅員等、約50項目の基本諸元。1橋1枚のシンプルな台帳）、
// 「橋梁台帳」（支承・材料集計・工事費等、490箇所超のセル結合を持つ非常に
// 密な構造設計・数量計算の帳票）、「画像」（位置図・工事費・維持管理表等）、
// 「付属図」（平面図・側面図等の添付図面）、「IMS設定シート」（非表示）。
//
// 内容は橋梁の基本諸元・構造設計等の台帳（施設台帳の一種）であり、実際の
// 点検記録（点検調書）ではないため、画面上の分類は「施設台帳」に置いている
// （/import。以前は「点検調書」に誤って分類していた。会話ログ「橋梁台帳読み込みは
// 点検調書ではなくても、施設台帳に分類すると思います。区分が違うので修正して
// ください」参照）。ルートも/bridge-ledgers（「点検調書」を意味する/inspections
// 配下から外した）。実際の定期点検報告書（別紙２　様式１様式２形式）は、
// 下記の別モデルBridgeInspectionとして取り込む（会話ログ「過去の門型標識点検の
// エクセルファイルを参考に橋梁の点検様式の取り込みもできるようにしてほしい」
// 参照）。
// 会話ログで、道路防災管理という本来の目的に対して使用頻度が低い「橋梁台帳」
// 「画像」「付属図」シートまで点検調書と同じ「1項目=1DB列＋忠実なCSSレイアウト」
// で作り込むのはコストに見合わないと判断し、以下のように使い分けている
// （会話ログ「汎用テーブル表示で再現（推奨）」参照）:
//   - 「橋梁調書」シート（基本諸元）: 点検調書の様式１と同じ考え方で、
//     項目ごとにこのモデルの列として構造化する（管理番号・緯度経度等、
//     検索・地図表示に使う可能性がある情報のため）。
//   - 「橋梁台帳」「画像」「付属図」シート: 個々の項目をDB列化せず、
//     セル値・結合・列幅・行高をそのままJSONで保持し（BridgeLedgerSheet、
//     lib/excel/excel-grid-extract.ts参照）、表示時に汎用のExcelグリッド
//     再現コンポーネント（components/ExcelSheetGrid.tsx）でHTML表として
//     見た目だけ忠実に再現する（個別項目の検索・編集はできないが、密な
//     帳票を人が参照する用途には十分で、将来別の密な帳票が来ても
//     スキーマ変更なしで対応できる）。
model BridgeLedger {
  id String @id @default(cuid())

  facilityListItemId String?
  facilityListItem   FacilityListItem? @relation(fields: [facilityListItemId], references: [id])

  // 管理番号は「橋梁調書」シート内（管理番号セル）から取得できる
  // （点検調書と異なり、ファイル名からではなくExcel本体から読み取れる）。
  managementNo       String?
  managementCategory String? // 管理区分（例: 管理中）

  bridgeNameKana String? // 橋名（フリガナ）
  bridgeName     String? // 橋名（漢字）
  officeName     String? // 事務所名
  routeName      String? // 路線名
  spanCount      Int? // 径間数
  // 架設年月日はExcel側が未入力だと1970-01-01等の異常値になることがある
  // （FacilityListItem.constructionYearと同じ問題。会話ログの過去の対応と
  // 同じ方針で、日付化せず文字列のまま保持する）。
  constructedAt  String?

  location      String? // 所在地（「自：〜　至：〜」をまとめた文字列）
  bridgeType    String? // 橋種（例: ＲＣ橋）
  bridgeLengthM Decimal? @db.Decimal(6, 2) // 橋長(m)

  superstructureType String? // 上部工形式
  deckMaterial       String? // 床板材料
  substructureType   String? // 下部工形式（A1／A2／橋脚の内容をまとめた文字列）
  appliedSpec        String? // 適用示方書

  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  // 幅員・面積は、車道／自・歩道／路肩／地覆／その他／合計の6区分がExcel上
  // そのまま列になっているため、同じ粒度で保持する。
  widthRoadwayM  Decimal? @db.Decimal(6, 2)
  widthSidewalkM Decimal? @db.Decimal(6, 2)
  widthShoulderM Decimal? @db.Decimal(6, 2)
  widthCurbM     Decimal? @db.Decimal(6, 2)
  widthOtherM    Decimal? @db.Decimal(6, 2)
  widthTotalM    Decimal? @db.Decimal(6, 2)
  widthRemarks   String? // 幅員表の備考（例: 石垣橋台）

  areaRoadwayM2  Decimal? @db.Decimal(8, 2)
  areaSidewalkM2 Decimal? @db.Decimal(8, 2)
  areaShoulderM2 Decimal? @db.Decimal(8, 2)
  areaCurbM2     Decimal? @db.Decimal(8, 2)
  areaOtherM2    Decimal? @db.Decimal(8, 2)
  areaTotalM2    Decimal? @db.Decimal(8, 2)

  censusNo               String? // センサス番号
  seismicReinforcement   String? // 耐震補強
  surveyYear             String? // 調査年
  trafficVolume          String? // 交通量
  largeVehicleTraffic    String? // 大型車交通量
  coastDistance          String? // 海岸からの距離
  emergencyTransportRoad String? // 緊急輸送道路の指定
  priorityRoute          String? // 優先確保ルートの指定

  mainGirderCount     Int? // 主桁本数
  abutmentHeightM     Decimal? @db.Decimal(6, 2) // 橋台高さ
  pierHeightM         Decimal? @db.Decimal(6, 2) // 橋脚高さ
  occupyingObjectName String? // 占用物件（名称）

  denselyPopulatedArea String? // 人工密集地区
  detourRoute          String? // 迂回路
  busRoute             String? // バス路線

  overpassRailway String? // 跨線橋
  overpassRoad    String? // 跨道線
  overseaBridge   String? // 渡海橋
  longBridge      String? // 長大橋
  saltDamageArea  String? // 塩害地域
  upDownLine      String? // 上下線

  bicycleRoad     String? // 自転車道
  footbridge      String? // 歩道橋
  sideRoadBridge  String? // 側道橋
  weatheringSteel String? // 耐候性鋼材
  underRiver      String? // 路下条件・河川
  underRoad       String? // 路下条件・道路

  bridgeManagementCategory String? // 橋梁管理区分
  roadCategory             String? // 自専道or一般道
  loadRestriction          String? // 荷重制限
  underRailway             String? // 路下条件・鉄道
  underOther               String? // 路下条件・その他

  sourceFileName String?

  // 「橋梁台帳」「画像」「付属図」シートの汎用グリッド再現データ
  // （上記コメント参照）。
  sheets   BridgeLedgerSheet[]
  favorite Favorite? // GateSignInspection.favoriteと同じ考え方（Favoriteモデルのコメント参照）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([managementNo])
  @@index([facilityListItemId])
}

// BridgeLedger 1件に紐づく「汎用再現シート」1枚分（橋梁台帳・画像・付属図の
// いずれか）。個々のセルをDB列化せず、セル値・結合範囲・列幅・行高をまとめて
// gridにJSONで保持する（構造はlib/excel/excel-grid-extract.tsのExtractedGrid
// 型を参照。components/ExcelSheetGrid.tsxで汎用的にHTML表として描画する）。
model BridgeLedgerSheet {
  id             String       @id @default(cuid())
  bridgeLedgerId String
  bridgeLedger   BridgeLedger @relation(fields: [bridgeLedgerId], references: [id], onDelete: Cascade)

  sheetName String // 元のExcelシート名（例: 橋梁台帳、画像、付属図）
  label     String // タブ表示名（初期値はsheetNameと同じ）
  sortOrder Int    @default(0)
  grid      Json // ExtractedGrid（セル値・結合・列幅・行高）

  createdAt DateTime @default(now())

  @@index([bridgeLedgerId])
}

// ── 点検調書（道路＞橋梁） ─────────────────────────────────────
// 点検調書タブ＞道路＞橋梁＞エクセル読み込み（会話ログ「過去の門型標識点検の
// エクセルファイルを参考に橋梁の点検様式の取り込みもできるようにしてほしい」
// 参照。サンプルファイル「G57-AB-908913_01_富田橋.xlsx」で構造を確認済み）。
// 「別紙２　様式１様式２」形式で、点検調書（門型標識＝GateSignInspection）と
// 同じ発行元・同じ様式体系の橋梁版。1ファイル＝1橋の定期点検報告書。
// Excelは32シート構成:
//   - 道路橋様式１・様式２: 基本情報・部材単位の総括表（粗い情報）＋
//     状況写真のハイライト（4枚程度）。
//   - 定期点検調書（その１）: 橋梁諸元（BridgeLedgerの橋梁調書シートと
//     ほぼ同じ項目。橋の基本諸元は既にBridgeLedgerで構造化済みのため、
//     このモデルでは重複させず、識別・検索に要る範囲（橋梁名・路線名・
//     所在地・事務所名・管理番号）＋点検固有の情報（点検日・点検者・
//     責任者）だけを持つ）。
//   - 定期点検調書（その２）: 橋梁一般図（位置図・平面図・側面図・断面図）。
//   - 定期点検調書（その３）: 現地状況写真（起点→終点等）。
//   - 定期点検調書（その４）径間N: 径間ごとの損傷評価の総括表（粗い情報。
//     その５の詳細カードと内容が重なるため、GateSignInspectionの様式１
//     総括表と同じ理由で取り込み対象外）。
//   - 定期点検調書（その５）N_径間M: 径間ごとの損傷箇所別の写真付き詳細
//     カード（部材名・部材番号・損傷種類・コメント・写真）。GateSignInspection
//     の様式２カードに相当し、これをBridgeInspectionMemberとして取り込む。
//   - 損傷評価のまとめ: 全径間の総括表（その４よりさらに粗い、派生データ）。
//     取り込み対象外。
//   - IMS設定シート（非表示）: 緯度経度（度分秒）等。
model BridgeInspection {
  id String @id @default(cuid())

  facilityListItemId String?
  facilityListItem   FacilityListItem? @relation(fields: [facilityListItemId], references: [id], onDelete: SetNull)
  // 「定期点検調書（その１）」の「橋梁番号」欄（Excel内に実データあり。
  // 門型標識と異なりファイル名からではなくExcel本体から取得できる）。
  managementNo       String?

  bridgeName     String? // 橋梁名
  bridgeNameKana String? // フリガナ
  routeName      String?
  location       String?
  officeName     String? // 事務所名
  spanCount      Int? // 径間数

  latitude  Decimal? @db.Decimal(9, 6) // IMS設定シートの緯度(度)(分)(秒)から10進度に変換
  longitude Decimal? @db.Decimal(9, 6)

  inspectionDate    DateTime? // 点検日
  inspectorCompany  String? // 点検者（会社名）
  responsiblePerson String? // 責任者

  overallJudgment String? // 道路橋毎の健全性の診断（判定区分Ⅰ〜Ⅳ）
  overallFindings String? // 所見等

  // 「道路橋様式１」自体に載っている項目（「定期点検調書（その１）」＝橋梁諸元
  // シートとは別物。以前は様式１タブにその１の項目を混ぜて表示しており誤りだった。
  // 会話ログ「エクセルの最初のタブには、径間数についての表記はありませんよね。
  // ...管理者名、定期点検実施年月日、路下条件、代替路の有無、自専道or一般道、
  // 緊急避難道路、占有物件(名称)、などエクセルに書いてある通りに実装して
  // ほしいです」参照）。
  managerOrgName         String? // 管理者名
  underRoadCondition     String? // 路下条件
  hasAlternateRoute      String? // 代替路の有無
  roadCategory           String? // 自専道or一般道
  emergencyTransportRoad String? // 緊急輸送道路
  occupyingObjects       String? // 占用物件（名称）
  installedYear          Int? // 架設年次
  bridgeLengthM          Decimal? @db.Decimal(6, 2) // 橋長
  roadWidthM             Decimal? @db.Decimal(6, 2) // 幅員
  structureType          String? // 橋梁形式

  // 「道路橋様式１」の「部材単位の診断（各部材毎に最悪値を記入）」総括表
  // （主桁・横桁・床版・下部構造・支承部・その他の6行×判定区分/変状の種類/
  // 備考/応急措置後の判定区分/応急措置内容/応急措置及び判定実施年月日の6項目。
  // 実データ「G57-AB-908913_01_富田橋.xlsx」で確認済み）。これは橋全体を通した
  // 1つだけの総合評価であり、GateSignInspection.memberOverviewと同じ理由・
  // 同じ形でJSON列として保持する（会話ログ「橋梁にも部材ごとの診断は必要...
  // 部材ごとの診断のまとめとなるのは一つしか存在していないことから、これを
  // とりあえず、様式1に記載するようにしてください」参照）。要素の型は
  // lib/excel/bridge-inspection-import.tsのBridgeInspectionMemberOverviewRow参照。
  memberOverview Json?

  // 「定期点検調書（その４）径間N」の径間ごとの損傷評価（床版・主桁・横桁・
  // 橋台橋脚・支承・排水施設・伸縮装置・高欄地覆・路面の9項目×判定区分/
  // 変状の種類）。様式１の総括表とは別に、径間ごとの粗い評価として存在する
  // （会話ログ「各径間ごとの判定を定期点検調書(その４)で行い、その総合評価
  // として、様式1に部材ごとの診断を行っています...各径間ごとの評価は、
  // 定期点検調書(その４)に書くという形」参照）。径間の数だけ配列要素を持つ
  // JSON列として保持する（径間ごとに専用テーブル行を作るほどの検索・絞り込み
  // 需要が無いため、memberOverviewと同じ考え方）。要素の型は
  // lib/excel/bridge-inspection-import.tsのBridgeInspectionSpanDiagnosis参照。
  spanDiagnoses Json?

  sourceFileName String?

  // 年度別履歴保存（GateSignInspection.previousInspectionIdと同じ考え方。
  // そちらのコメント参照）。
  previousInspectionId   String?           @unique
  previousInspection     BridgeInspection? @relation("BridgeInspectionHistory", fields: [previousInspectionId], references: [id], onDelete: SetNull)
  supersededByInspection BridgeInspection? @relation("BridgeInspectionHistory")

  members  BridgeInspectionMember[]
  photos   BridgeInspectionPhoto[]
  favorite Favorite? // GateSignInspection.favoriteと同じ考え方（Favoriteモデルのコメント参照）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([managementNo])
  @@index([facilityListItemId])
}

// 「定期点検調書（その５）N_径間M」の損傷箇所ごとの写真付き詳細カード
// （GateSignInspectionMemberの橋梁版）。径間ごとにシートが分かれるため
// spanNoを持つ（径間番号。「定期点検調書（その５）」内の「径間番号」欄）。
model BridgeInspectionMember {
  id           String           @id @default(cuid())
  inspectionId String
  inspection   BridgeInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  spanNo Int // 径間番号
  // 同じ径間内で複数シート（その５1〜4等、損傷箇所の数に応じて複製される）に
  // 分かれる場合の並び順（1始まり）。詳細画面でExcelのシート構成に合わせて
  // 表示するため（GateSignInspectionMember.pageNoと同じ考え方）。
  pageNo Int @default(1)

  photoNo      Int? // 写真番号
  memberName   String? // 部材名
  memberDetail String? // 部材番号
  damageType   String? // 損傷種類
  findings     String? // コメント（所見）

  photoUrl String? // 損傷状況写真（Vercel Blob）

  sortOrder Int @default(0)

  @@index([inspectionId])
}

// 「定期点検調書（その２）」（橋梁一般図: 位置図・平面図・側面図・断面図）・
// 「定期点検調書（その３）」（現地状況写真）・道路橋様式２（状況写真の
// ハイライト）等、個別の損傷カードには紐付かない全体写真・図面
// （GateSignInspectionPhotoと同じ考え方）。
model BridgeInspectionPhoto {
  id           String           @id @default(cuid())
  inspectionId String
  inspection   BridgeInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  url       String
  caption   String? // 例: 位置図、起点→終点
  sortOrder Int     @default(0)

  // 由来シート（Web側のタブと1対1。以前は様式１・様式２・その２・その３の
  // 写真を全て1本の配列にまとめて様式１タブに表示していたが、Excelの
  // シート構成に合わせて別タブに分けるようにした。会話ログ「これ以降は、
  // エクセルに合わせて次のタブに移ります」参照）。
  // overview=様式１の全景写真、damageHighlight=様式２の損傷写真、
  // drawing=その２の橋梁一般図、site=その３の状況写真。
  category String @default("overview") // BridgeInspectionPhotoCategory（lib/excel/bridge-inspection-import.ts参照）

  // category==="damageHighlight"のときだけ使う（様式２のキャプション文字列を
  // パースした結果。lib/excel/bridge-inspection-import.tsのコメント参照）。
  memberName String?
  damageType String?
  judgment   String?
  spanRef    String?

  @@index([inspectionId])
}

// ── 点検調書（道路＞法面構造物） ─────────────────────────────────
// 点検調書タブ＞道路＞法面構造物＞エクセル読み込み（会話ログ「法面構造物
// （新規実装一式）」参照。サンプルファイル「A01-AH-900051_01_４３１号_
// 西川津町_18.88_法面構造物.xlsx」ほか34件で構造を確認済み）。
// GateSignInspection・BridgeInspectionとは発行元・様式が異なる独自体系で、
// Excelは以下の構成:
//   - 点検表: 1シートに箇所番号・路線名・所在地・緯度経度・点検日・評点評価
//     （構造物評点/地山評点/Ⅰ〜Ⅲ）・総括コメント等、検索・地図表示に必要な
//     項目が全てまとまっている（GateSignInspection/BridgeInspectionの
//     様式１に相当）。この情報量の多いシート自体を、SlopeStructureInspectionSheet
//     （sheetName="点検表"）としてグリッド保存もし、Web側でも元の見た目を
//     確認できるようにする（下記「チェックシートについて」と同じ理由）。
//   - 様式1〜7（点検チェックシート）: 法面構造物の種類（モルタル吹付け・
//     のり枠・ロックネット・擁壁・石/ブロック積擁壁・落石防護柵・雪崩防止柵）
//     ごとに用意された固定7種類のテンプレートシートで、実際にはこのうち
//     「点検表」のY2セル（点検対象項目）が指す1枚だけに実データが入り、
//     残り6枚は空のテンプレートのまま（実データ34件で確認済み）。
//   - IMS設定シート: 門型標識・橋梁と異なり緯度経度はここではなく点検表側に
//     載っている。代わりに「点検対象項目→対応する様式シート名」の対応表を
//     持つが、各様式シートのB1（例:「点検チェックシート　モルタル吹付け」）
//     から自己記述的に判定できるため、取込処理はこの対応表には依存しない
//     （lib/excel/slope-structure-inspection-import.ts参照。将来ファイルの
//     シート順が変わっても壊れないようにするため）。
//
// 【チェックシートについて・データモデルの設計判断】7種類のチェックシートは
// 項目構成（区分・配点・評点・備考の行数や意味）が構造物種類ごとに全く異なり
// （実データで確認済み。例: モルタル吹付けは「開口ひび割れ」「浮き・剥離」等、
// 擁壁系は全く別の項目体系）、個別にDB列化すると7種類ぶんの別スキーマが
// 必要になり複雑化する一方、これらは検索・絞り込みの対象にする必要が薄い
// （検索・地図・お気に入りに必要な情報＝評点合計・健全度評価Ⅰ〜Ⅲは既に
// structureScore/groundScore/overallJudgmentとして構造化済み）。そのため
// BridgeLedgerSheet（橋梁台帳の密な帳票）と同じ「元Excelのセル配置を
// ExtractedGrid（lib/excel/excel-grid-extract.ts）としてそのまま保存し、
// ExcelSheetGridで見た目だけ忠実に再現する」方針にした（CLAUDE.md 10章・
// 17章の「密で構造物種類ごとに異なる帳票は、個別スキーマ化よりも汎用グリッド
// 表示が適切」という考え方に沿う）。
model SlopeStructureInspection {
  id String @id @default(cuid())

  facilityListItemId String?
  facilityListItem   FacilityListItem? @relation(fields: [facilityListItemId], references: [id], onDelete: SetNull)
  // 点検表「箇所番号」欄（例: A01-AH-900051）。ファイル名にも同じ値が含まれるが、
  // 門型標識と異なりExcel本体（H2セル）から取得できる（会話ログ「エクセルに
  // 書いてある通りに実装してほしい」の方針を踏襲）。
  managementNo String?

  structureType String? // 点検対象項目（例: モルタル吹付け）。点検表Y2
  managerOrgName String? // 管理機関名。点検表H3
  routeName      String?
  location       String? // 所在地（地先名。「松江市」+「西川津町」を結合済み）
  distanceMarkFrom String? // 距離標（自）
  distanceMarkTo   String? // 距離標（至）

  latitude  Decimal? @db.Decimal(9, 6) // 点検表の緯度(度)(分)(秒)から10進度に変換
  longitude Decimal? @db.Decimal(9, 6)

  inspectionDate DateTime? // 点検日
  photoDate      DateTime? // 撮影日（現況写真の撮影日。点検日と別のことがある）
  weather        String? // 天候

  // 評点による評価（構造物評点計・地山評点計）と、それに基づく点検者の評価
  // （Ⅰ：対応不要／Ⅱ：経過観察／Ⅲ：要対策。GateSignInspection/
  // BridgeInspectionのⅠ〜Ⅳ判定区分と表記は違うが、lib/labels.tsの
  // JUDGMENT_BADGEはⅠ〜Ⅲの配色も含むため共通コンポーネントで表示できる）。
  structureScore  Decimal? @db.Decimal(6, 2)
  groundScore     Decimal? @db.Decimal(6, 2)
  overallJudgment String? // Ⅰ|Ⅱ|Ⅲ

  geologyDescription   String? // 背後地山の地形・地質
  summaryComment        String? // 総括コメント
  inspectionFindings    String? // 点検状況（注意箇所等）
  dailyInspectionPoints String? // 日常点検の着眼点

  sourceFileName String?

  // 年度別履歴保存（GateSignInspection.previousInspectionIdと同じ考え方。
  // そちらのコメント参照）。
  previousInspectionId   String?                    @unique
  previousInspection     SlopeStructureInspection?  @relation("SlopeStructureInspectionHistory", fields: [previousInspectionId], references: [id], onDelete: SetNull)
  supersededByInspection SlopeStructureInspection?  @relation("SlopeStructureInspectionHistory")

  sheets   SlopeStructureInspectionSheet[]
  photos   SlopeStructureInspectionPhoto[]
  favorite Favorite? // GateSignInspection.favoriteと同じ考え方

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([managementNo])
  @@index([facilityListItemId])
}

// 「点検表」シートと、点検対象項目に該当する「様式N（点検チェックシート）」
// シートの2枚を、元の見た目のまま保存する（BridgeLedgerSheetと同じ方針。
// SlopeStructureInspection本体コメント参照）。
model SlopeStructureInspectionSheet {
  id           String                    @id @default(cuid())
  inspectionId String
  inspection   SlopeStructureInspection  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  sheetName String // 元のExcelシート名（例: 点検表、様式1－(2)）
  label     String // タブ表示名（例: 点検表、点検チェックシート（モルタル吹付け））
  sortOrder Int    @default(0)
  grid      Json // ExtractedGrid（セル値・結合・列幅・行高）

  createdAt DateTime @default(now())

  @@index([inspectionId])
}

// 点検表の「現況写真」「平面図・概略断面図」、および写真番号付きの損傷写真
// （①②③…）。GateSignInspectionPhoto/BridgeInspectionPhotoと同じ考え方。
model SlopeStructureInspectionPhoto {
  id           String                   @id @default(cuid())
  inspectionId String
  inspection   SlopeStructureInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  url       String
  caption   String?
  sortOrder Int     @default(0)

  // sitePlan=平面図・概略断面図、overview=現況写真、damage=番号付き損傷写真
  // （lib/excel/slope-structure-inspection-import.ts参照）。
  category String @default("overview")

  @@index([inspectionId])
}

// ── 路線の道路種別・手動分類（点検調書＝Karte用） ──────────────────────
// 点検調書（防災＝Karte）の路線名（Karte.routeName）は、施設台帳
// （FacilityListItem.routeType）のような信頼できる道路種別データを持たない
// （路線名検索を道路種別＋路線名の2段階にする際に調査済み。施設台帳側の
// 路線名と照合しても一致が0件だった＝同じ路線でも別の名称体系で管理されている）。
//
// 以前はここに、利用者が/settingsで任意に道路種別を割り当てられる、Karte本体
// とは独立した上書きテーブル（RouteRoadTypeOverride）があったが廃止した。
// 未分類だった路線を確認したところ全て島根県道だったことが判明し（会話ログ
// 「先ほど分類されていなかったのは、すべて県道でした」参照）調査し直した
// ところ、Karte自体に元々roadType列（冒頭のRoadType enum。Excel「Listシート」
// の道路種別。全件に設定済み）という信頼できる実データが既に存在していたため、専用の
// 設定画面・上書きテーブルは不要と判断した。現在はKarte.roadTypeから
// lib/karte-route-classification.tsが機械的に判定する。
